{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "exam_code": {
      "const": "SAA-C03"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "mode": {
      "enum": [
        "practice",
        "exam"
      ]
    },
    "scope": {
      "enum": [
        "mixed",
        "focused"
      ]
    },
    "focus": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "question_count": {
      "type": "integer",
      "minimum": 1
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "exam_code",
    "title",
    "language",
    "mode",
    "scope",
    "question_count",
    "questions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "exam"
          }
        }
      },
      "then": {
        "required": [
          "duration_minutes"
        ]
      },
      "else": {
        "not": {
          "required": [
            "duration_minutes"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "focused"
          }
        }
      },
      "then": {
        "required": [
          "focus"
        ]
      },
      "else": {
        "not": {
          "required": [
            "focus"
          ]
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "stem": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "primary_domain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "task_id": {
          "type": "string",
          "pattern": "^[1-4]\\.[1-5]$"
        },
        "service_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "type": {
          "enum": [
            "single",
            "multiple"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "text",
              "explanation"
            ],
            "additionalProperties": false
          },
          "minItems": 4
        },
        "correct_option_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "verified_on": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "title",
              "url",
              "verified_on"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "stem",
        "primary_domain",
        "task_id",
        "service_tags",
        "type",
        "options",
        "correct_option_ids",
        "sources"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "single"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "maxItems": 4
              },
              "correct_option_ids": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "minItems": 5
              },
              "correct_option_ids": {
                "minItems": 2
              }
            }
          }
        }
      ]
    }
  }
}
